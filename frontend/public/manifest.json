      "url": "/transactions",
      "icons": [{ "src": "/web-app-manifest-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Analytics",
      "short_name": "Charts",
      "description": "View spending analytics",
      "url": "/analytics",
      "icons": [{ "src": "/web-app-manifest-192x192.png", "sizes": "192x192", "type": "image/png" }]
